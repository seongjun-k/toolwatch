CLAUDE.md
.claude/

# 대용량 — git 제외
dataset/*
!dataset/.gitkeep
*.pt
__pycache__/

# 가상환경 — 로컬 전용, requirements.txt로 재현
.venv/

# YOLO 학습 산출물
runs/

# 실행 로그
logs/*
!logs/.gitkeep

# 반출 스냅샷
src/server/snapshots/

# SQLite DB (E1)
src/server/toolwatch.db

# VAPID 개인키 (E3)
src/server/vapid_private.pem

# mkcert 인증서 (E3 HTTPS)
src/server/cert.pem
src/server/cert-key.pem

# 실제 설정(시크릿 포함) — config.example.json을 복사해 채워서 사용
src/server/config.json
src/pi/config.json

# DB 스냅샷 백업 (run_server.bat 기동 시 생성)
backups/

# 개인정보(학번·이름)·내부 주소가 들어간 문서 — 원격에 올리지 않는다 (공개 저장소)
